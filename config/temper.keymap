/*
 * FunkeeB Temper keymap based on:
 * https://github.com/xphstos/xphstos_temper_zmk_
 *
 * Kept as plain ZMK devicetree for compatibility with both
 * Nick Coutsos' ZMK Keymap Editor and ZMK Studio.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <165>;
};

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            quick-tap-ms = <65>;
            tapping-term-ms = <125>;
            global-quick-tap;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <105>;
            quick-tap-ms = <60>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 20 21 22 23 24 14 25 15 5 6 16 26 27 17 7 8 18 28 29 19 9 11 12 13>;
            require-prior-idle-ms = <70>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <105>;
            quick-tap-ms = <60>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <0 10 20 21 1 11 12 2 3 4 24 14 13 23 22 25 26 28 27 29 9 8 7 6 5 15 16 17 18 30 31 32 33 34 35>;
            require-prior-idle-ms = <70>;
            hold-trigger-on-release;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        space_alt: space_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_ALT";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <235>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <10 12 20 21 16 17 19 6>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 19>;
            layers = <0>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <27 28>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <18 19>;
            layers = <0>;
            timeout-ms = <150>;
        };

        boot_l {
            bindings = <&bootloader>;
            key-positions = <0 4 32>;
            layers = <0>;
        };

        esc_left {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
            timeout-ms = <100>;
        };

        bluetooth {
            bindings = <&mo 1>;
            key-positions = <32 33>;
        };

        del_left {
            bindings = <&kp DEL>;
            key-positions = <20 23>;
            timeout-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q              &kp W           &kp E               &kp R             &kp T                         &kp Y      &kp U             &kp I                &kp O           &kp P
&hml LEFT_SHIFT A  &hm LEFT_GUI S  &hm LEFT_CONTROL D  &hml RIGHT_ALT F  &kp G                         &kp H      &hmr RIGHT_ALT J  &hm RIGHT_CONTROL K  &hm LEFT_GUI L  &hmr RIGHT_SHIFT SEMICOLON
&kp Z              &kp X           &kp C               &kp V             &kp B                         &kp N      &kp M             &kp COMMA            &kp DOT         &mt BACKSLASH SLASH
                                     &lt 5 BACKSPACE     &lt 2 TAB         &space_alt RIGHT_ALT SPACE    &kp ENTER  &lt 3 ENTER       &lt 4 DEL
            >;
        };

        bluetooth_layer {
            display-name = "BLT";
            bindings = <
&bootloader  &trans  &trans  &trans  &studio_unlock    &bt BT_CLR     &trans        &trans        &trans        &bootloader
&trans       &trans  &trans  &trans  &trans            &trans         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
&trans       &trans  &trans  &trans  &trans            &kp LG(LA(K))  &kp C_VOL_UP  &kp C_VOL_DN  &trans        &bt BT_SEL 4
                     &trans  &trans  &trans            &trans         &trans        &trans
            >;
        };

        navi_right_layer {
            display-name = "NavR";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6    &kp NUMBER_7  &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0
&trans        &trans        &trans        &trans        &trans          &kp LEFT        &kp DOWN      &kp UP          &kp RIGHT        &kp BACKSLASH
&kp LC(Z)     &kp LC(Y)     &kp LC(X)     &kp LC(C)     &kp LC(V)       &kp UNDERSCORE  &kp PLUS      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp BACKSLASH
                              &trans        &trans        &trans          &kp UNDERSCORE  &trans        &trans
            >;
        };

        navi_left_layer {
            display-name = "NavL";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN      &kp HASH           &kp DOLLAR             &kp PERCENT    &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &kp LEFT_BRACE   &kp LEFT_BRACKET   &kp LEFT_PARENTHESIS   &trans         &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp GRAVE
&trans           &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &trans         &kp UNDERSCORE  &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE       &kp TILDE
                                    &trans             &kp PIPE               &trans         &trans          &trans         &trans
            >;
        };

        function_layer {
            display-name = "Fun";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &trans    &trans  &trans  &trans  &trans  &trans
&kp F5  &kp F6   &kp F7   &kp F8   &trans    &trans  &trans  &trans  &trans  &trans
&kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans   &trans   &trans    &trans  &trans  &trans
            >;
        };

        numerical_layer {
            display-name = "Num";
            bindings = <
&kp C_AL_CALC  &trans  &trans  &trans  &trans    &kp PLUS      &kp N7        &kp N8        &kp N9        &kp MINUS
&trans         &trans  &trans  &trans  &trans    &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &mt KP_DIVIDE SLASH
&trans         &trans  &trans  &trans  &trans    &kp PERIOD    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA
                       &trans  &trans  &trans    &kp N0        &trans        &kp EQUAL
            >;
        };
    };
};
