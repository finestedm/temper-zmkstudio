/*
 * FunkeeB Temper keymap
 *
 * The keymap is intentionally written as plain ZMK devicetree so it can be
 * edited both with ZMK Studio and Nick Coutsos' ZMK Keymap Editor.
 */

#include <behaviors.dtsi>
#include <behaviors/mouse_key_press.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        /* Miryoku-compatible home-row mod and layer-tap timing. */
        u_mt: user_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        u_lt: user_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        /* Double-tap guards retained from the previous Miryoku keymap. */
        to_base: to_base {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 0>;
        };

        to_extra: to_extra {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 1>;
        };

        to_tap: to_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 2>;
        };

        to_button: to_button {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 3>;
        };

        to_nav: to_nav {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 4>;
        };

        to_mouse: to_mouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 5>;
        };

        to_media: to_media {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 6>;
        };

        to_num: to_num {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 7>;
        };

        to_sym: to_sym {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 8>;
        };

        to_fun: to_fun {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to 9>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt_0_clear>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt_1_clear>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt_2_clear>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt_3_clear>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&bt_4_clear>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        out_tog: out_tog {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&out OUT_TOG>, <&out OUT_USB>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        caps_word_or_caps: caps_word_or_caps {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    macros {
        bt_0_clear: bt_0_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
        };

        bt_1_clear: bt_1_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
        };

        bt_2_clear: bt_2_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
        };

        bt_3_clear: bt_3_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
        };

        bt_4_clear: bt_4_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q            &kp W            &kp E            &kp R            &kp T              &kp Y            &kp U            &kp I            &kp O            &kp P
&u_mt LGUI A     &u_mt LALT S     &u_mt LCTRL D    &u_mt LSHFT F    &kp G              &kp H            &u_mt LSHFT J    &u_mt LCTRL K    &u_mt LALT L     &u_mt LGUI SQT
&u_lt 3 Z        &u_mt RALT X     &kp C            &kp V            &kp B              &kp N            &kp M            &kp COMMA        &u_mt RALT DOT    &u_lt 3 SLASH
                                    &u_lt 6 ESC      &u_lt 4 SPACE    &u_lt 5 TAB         &u_lt 8 RET       &u_lt 7 BSPC      &u_lt 9 DEL
            >;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&kp Q            &kp W            &kp F            &kp P            &kp B              &kp J            &kp L            &kp U            &kp Y            &kp SQT
&u_mt LGUI A     &u_mt LALT R     &u_mt LCTRL S    &u_mt LSHFT T    &kp G              &kp M            &u_mt LSHFT N    &u_mt LCTRL E    &u_mt LALT I     &u_mt LGUI O
&u_lt 3 Z        &u_mt RALT X     &kp C            &kp D            &kp V              &kp K            &kp H            &kp COMMA        &u_mt RALT DOT    &u_lt 3 SLASH
                                    &u_lt 6 ESC      &u_lt 4 SPACE    &u_lt 5 TAB         &u_lt 8 RET       &u_lt 7 BSPC      &u_lt 9 DEL
            >;
        };

        tap_layer {
            display-name = "Tap";
            bindings = <
&kp Q            &kp W            &kp F            &kp P            &kp B              &kp J            &kp L            &kp U            &kp Y            &kp SQT
&kp A            &kp R            &kp S            &kp T            &kp G              &kp M            &kp N            &kp E            &kp I            &kp O
&kp Z            &kp X            &kp C            &kp D            &kp V              &kp K            &kp H            &kp COMMA        &kp DOT          &kp SLASH
                                    &kp ESC          &kp SPACE        &kp TAB             &kp RET           &kp BSPC          &kp DEL
            >;
        };

        button_layer {
            display-name = "Button";
            bindings = <
&kp K_UNDO       &kp LS(DEL)      &kp LC(INS)      &kp LS(INS)      &kp K_AGAIN        &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
&kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
&kp K_UNDO       &kp LS(DEL)      &kp LC(INS)      &kp LS(INS)      &kp K_AGAIN        &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
                                    &mkp MB3         &mkp MB1         &mkp MB2            &mkp MB2          &mkp MB1          &mkp MB3
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&bootloader      &to_tap          &to_extra        &to_base         &studio_unlock     &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
&kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &caps_word_or_caps
&none            &kp RALT         &to_num          &to_nav          &none              &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp INS
                                    &none            &none            &none              &kp RET           &kp BSPC          &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&bootloader      &to_tap          &to_extra        &to_base         &none              &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
&kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &kp KP_N4        &kp KP_N2        &kp KP_N8        &kp KP_N6        &none
&none            &kp RALT         &to_sym          &to_mouse        &none              &none            &none            &none            &none            &none
                                    &none            &none            &none              &mkp MB2          &mkp MB1          &mkp MB3
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader      &to_tap          &to_extra        &to_base         &none              &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG
&kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &kp C_PREV       &kp C_VOL_DN     &kp C_VOL_UP     &kp C_NEXT       &ext_power EP_TOG
&none            &kp RALT         &to_fun          &to_media        &none              &bt_0            &bt_1            &bt_2            &bt_3            &out_tog
                                    &none            &none            &none              &kp C_STOP        &kp C_PP          &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp LBKT         &kp N7           &kp N8           &kp N9           &kp RBKT           &none            &to_base         &to_extra        &to_tap          &bootloader
&kp SEMI         &kp N4           &kp N5           &kp N6           &kp EQUAL          &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
&kp GRAVE        &kp N1           &kp N2           &kp N3           &kp BSLH           &none            &to_num          &to_nav          &kp RALT         &none
                                    &kp DOT          &kp N0           &kp MINUS           &none             &none             &none
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp LBRC         &kp AMPS         &kp ASTRK        &kp LPAR         &kp RBRC           &none            &to_base         &to_extra        &to_tap          &bootloader
&kp COLON        &kp DLLR         &kp PRCNT        &kp CARET        &kp PLUS           &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
&kp TILDE        &kp EXCL         &kp AT           &kp HASH         &kp PIPE           &none            &to_sym          &to_mouse        &kp RALT         &none
                                    &kp LPAR         &kp RPAR         &kp UNDER           &none             &none             &none
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&kp F12          &kp F7           &kp F8           &kp F9           &kp PSCRN          &none            &to_base         &to_extra        &to_tap          &bootloader
&kp F11          &kp F4           &kp F5           &kp F6           &kp SLCK           &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
&kp F10          &kp F1           &kp F2           &kp F3           &kp PAUSE_BREAK    &none            &to_fun          &to_media        &kp RALT         &none
                                    &kp K_APP        &kp SPACE        &kp TAB             &none             &none             &none
            >;
        };
    };
};
